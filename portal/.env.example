# Copy to .env.local. With none of the Supabase values set, the portal runs in
# demo mode with sample data and no email — handy for local design work.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the portal, used in sign-in and invitation links.
NEXT_PUBLIC_PORTAL_URL=https://portal.melanieberberette.design

# Comma-separated. These accounts become admins on first sign-in.
PORTAL_ADMIN_EMAILS=hello@melanieberberette.com

# Messages: email notifications (optional — chat works without them).
# Resend API key (resend.com → API Keys). Leave empty to skip notification
# emails; sign-in emails are unaffected, they come from Supabase Auth.
RESEND_API_KEY=
# Verified sender. Defaults to "Melanie Berberette <portal@melanieberberette.design>".
PORTAL_EMAIL_FROM=
# Where to send "new message from a client" emails. Defaults to PORTAL_ADMIN_EMAILS.
PORTAL_NOTIFY_EMAILS=

# Only used in demo mode, to sign the demo session cookie.
PORTAL_DEMO_SECRET=
