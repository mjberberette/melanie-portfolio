# Copy to .env.local. With none of the Supabase values set, the portal runs in
# demo mode with sample data and no email — handy for local design work.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the portal, used in sign-in and invitation links.
NEXT_PUBLIC_PORTAL_URL=https://portal.melanieberberette.design

# Comma-separated. These accounts become admins on first sign-in.
PORTAL_ADMIN_EMAILS=hello@melanieberberette.com

# Only used in demo mode, to sign the demo session cookie.
PORTAL_DEMO_SECRET=
